FROM node:24.2.0-alpine AS build-app

ARG VITE_APP_BUILD_VERSION
ENV VITE_APP_BUILD_VERSION=${VITE_APP_BUILD_VERSION}

WORKDIR /app/frontend

COPY ./frontend/package.json .
COPY ./frontend/package-lock.json .

RUN npm install

COPY ./frontend .

# Mounted only for this step, so the env file never lands in a layer.
RUN --mount=type=secret,id=frontend_env,target=/app/.env.prod npm run build

# Declared after the build, so toggling it does not rebuild the bundle.
ARG FORCE_RELOAD=false
RUN [ "$FORCE_RELOAD" = true ] && force=true || force=false; \
    printf '{"version":"%s","force":%s}\n' "$VITE_APP_BUILD_VERSION" "$force" > build/version.json


FROM nginxinc/nginx-unprivileged:1.30.4-alpine

COPY ./frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build-app /app/frontend/build /usr/share/nginx/html

EXPOSE 8080
