ARG RESTIC_VERSION=0.19.0

FROM restic/restic:${RESTIC_VERSION} AS restic

# Same major as the server, so dumps restore without version mismatches.
FROM postgres:15-alpine

RUN apk add --no-cache supercronic jq
COPY --from=restic /usr/bin/restic /usr/bin/restic
COPY ./backup/scheduler.sh ./backup/backup.sh ./backup/restore.sh /usr/local/bin/

# CMD only, so `compose run backup restore.sh ...` replaces the scheduler.
ENTRYPOINT []
CMD ["scheduler.sh"]
