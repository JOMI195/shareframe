# Test-only environment for the shared test stack. Committed on purpose: every
# value here is fake and the stack is destroyed after each run.
# Read by docker-compose.test.yml, by vite (`--mode test`, envDir is this dir),
# and by pytest (backend/pyproject.toml -> env_files).
COMPOSE_PROJECT_NAME=shareframe-test

DEBUG=True
PRODUCTION=False
SECRET_KEY=test-insecure-secret-key-not-for-any-real-deployment
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_ALLOWED_HOSTS='localhost 127.0.0.1 0.0.0.0 [::1] backend'
DJANGO_CSRF_TRUSTED_ORIGINS='http://localhost:3100 http://127.0.0.1:3100'
DJANGO_CORS_ALLOWED_ORIGINS='http://localhost:3100 http://127.0.0.1:3100'
FRONTEND_BASE_URL=http://localhost:3100/
DJANGO_DEFAULT_USER_PASSWORT_ON_DELETION=test-deleted-user-password

DJANGO_FRAME_AUTH_SECRET_KEY=test-frame-auth-secret
DJANGO_FRAME_ACCESSTOKEN_LIFETIME_DAYS=7
DJANGO_FRAME_ACCESSTOKEN_EXPIRATION_WINDOW_HOURS=24
DJANGO_FRAME_OTP_EXPIRY_MINUTES=10

DJANGO_IMAGES_UPLOADED_FILES_MAX_FILES_ONCE=15
DJANGO_IMAGES_UPLOADED_FILES_MAX_FILES_TOTAL=100
DJANGO_IMAGES_UPLOADED_FILES_MAX_SIZE_MB=20
DJANGO_IMAGES_AUTO_DELETE_INTERVAL_HOURS=3

DB_ENGINE=django.db.backends.postgresql
DB_NAME=backend_db
DB_USER=postgres
DB_PASSWORD=test-postgres-password
DB_HOST=backend_db
DB_PORT=5432
POSTGRES_DB=backend_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=test-postgres-password

# Host-side view of backend_db, used by the backend pytest run only. The compose
# services keep DB_HOST/DB_PORT above.
TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5433
TEST_MEDIA_ROOT=.pytest-mediafiles

EMAIL_HOST=mailhog
EMAIL_PORT=1025
EMAIL_HOST_USER=test@shareframe.local
EMAIL_HOST_PASSWORD=
ADMIN_NOTIFICATION_EMAIL=test@shareframe.local

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

APP_BUILD_VERSION=test
VITE_APP_BUILD_VERSION=test
VITE_API_BASE_URL=http://localhost:8100/api
VITE_API_MEDIA_BASE_URL=http://localhost:8100
VITE_APP_PRODUCTION=False
VITE_APP_COOKIE_CONSENT_LIFETIME=30
VITE_APP_UPLOADED_FILES_FILE_FORMATS='jpg jpeg png'
VITE_APP_UPLOADED_FILES_MAX_FILES_ONCE=15
VITE_APP_UPLOADED_FILES_MAX_FILES_TOTAL=100
VITE_APP_UPLOADED_FILES_MAX_SIZE_MB=20
VITE_APP_IMAGES_AUTO_DELETE_INTERVAL_HOURS=3
