{
  "uid": "shareframe-backup",
  "title": "Backup",
  "description": "restic backups of Postgres and the media and logs volumes: last run, failed steps, sizes, repository growth and integrity checks.",
  "tags": [
    "shareframe"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "title": "ShareFrame dashboards",
      "tags": [
        "shareframe"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "url": ""
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "stat",
      "title": "Last backup",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Time since the last successful run. Shows Failed when the latest run failed.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "-1": {
                  "text": "Failed",
                  "color": "red",
                  "index": 0
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90000
              },
              {
                "color": "red",
                "value": 93600
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(time() - shareframe_backup_last_success_timestamp_seconds) unless on() (shareframe_backup_last_run_success == 0) or on() ((shareframe_backup_last_run_success == 0) - 1)",
          "legendFormat": "",
          "instant": true,
          "range": false
