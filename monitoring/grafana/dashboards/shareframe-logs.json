{
  "uid": "shareframe-logs",
  "title": "Backend",
  "description": "Django request metrics, an auth summary, Celery task health and backend logs. The search, level and logger filters apply to the log panels.",
  "tags": [
    "shareframe"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 11,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "search",
        "label": "Search",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [],
        "hide": 0,
        "description": "Substring filter applied to every panel on this dashboard."
      },
      {
        "type": "custom",
        "name": "level",
        "label": "Level",
        "query": "DEBUG,INFO,WARNING,ERROR",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ],
          "selected": true
        },
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "DEBUG",
            "value": "DEBUG"
          },
          {
            "selected": false,
            "text": "INFO",
            "value": "INFO"
          },
          {
            "selected": false,
            "text": "WARNING",
            "value": "WARNING"
          },
          {
            "selected": false,
            "text": "ERROR",
            "value": "ERROR"
          }
        ]
      },
      {
        "type": "query",
        "name": "logger",
        "label": "Logger",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values({job=\"backend\"}, logger)",
        "query": {
          "label": "logger",
          "type": 1,
          "stream": "{job=\"backend\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ],
          "selected": true
        },
        "options": [],
        "hide": 0,
        "sort": 1,
        "description": "Python logger name. Pick websockets.frames / daphne.* for websocket traffic."
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "title": "ShareFrame dashboards",
      "tags": [
        "shareframe"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "url": ""
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Log lines/s",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(rate({job=\"backend\", logger=~\"$logger\", level=~\"$level\"} |= \"$search\" [$__auto]))"
        }
      ],
      "description": "Backend log volume per second under the current filters.",
      "id": 1
    },
    {
      "type": "stat",
      "title": "Errors/s",
      "datasource": {
