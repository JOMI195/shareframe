          "expr": "topk(10, sum by (logger) (rate({job=\"backend\", logger=~\"$logger\", level=~\"$level\"} |= \"$search\" [$__auto])))",
          "legendFormat": "{{logger}}"
        }
      ],
      "id": 2,
      "description": "Top 10 loggers by volume. Websocket traffic appears as websockets.frames / daphne.*."
    },
    {
      "type": "logs",
      "title": "Backend logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 11
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "showLabels": false,
        "showCommonLabels": false,
        "prettifyLogMessage": false
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{job=\"backend\", logger=~\"$logger\", level=~\"$level\"} |= \"$search\""
        }
      ],
      "description": "Django, Celery, websocket and application-server logs. Narrow with the Logger, Level and Search variables above.",
      "id": 3
