            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "shareframe_images_total"
        }
      ],
      "description": "Images excluding soft-deleted ones. Drives the disk trend below.",
      "id": 106
    },
    {
      "type": "timeseries",
      "title": "Host CPU usage %",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
