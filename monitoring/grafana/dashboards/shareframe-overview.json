        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(increase(django_http_responses_total_by_status_total{status=~\"5..\"}[1h])) or vector(0)",
          "legendFormat": "",
          "instant": true,
          "range": false
