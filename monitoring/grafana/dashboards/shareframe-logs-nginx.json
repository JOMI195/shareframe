{
  "uid": "shareframe-logs-nginx",
  "title": "Logs · nginx",
  "description": "nginx access and error logs from Loki. Only populated where nginx runs (prod, prod.local).",
  "tags": [
    "shareframe"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 12,
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "type": "textbox",
        "name": "search",
        "label": "Search",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "options": [],
        "hide": 0,
        "description": "Substring filter applied to every panel on this dashboard."
      },
      {
        "type": "query",
        "name": "vhost",
        "label": "nginx vhost",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values({job=\"nginx\", logtype=\"access\"}, server_name)",
        "query": {
          "label": "server_name",
          "type": 1,
          "stream": "{job=\"nginx\", logtype=\"access\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ],
          "selected": true
        },
        "options": [],
        "hide": 0,
        "sort": 1,
        "description": "Which nginx server block served the request."
      },
      {
        "type": "custom",
        "name": "monvhost",
        "label": "Monitoring vhost",
        "query": "hidden : monitoring[.].*, shown : a^",
        "multi": false,
        "includeAll": false,
        "hide": 0,
        "current": {
          "text": "hidden",
          "value": "monitoring[.].*",
          "selected": true
        },
        "options": [
          {
            "selected": true,
            "text": "hidden",
            "value": "monitoring[.].*"
          },
          {
            "selected": false,
            "text": "shown",
            "value": "a^"
          }
        ],
        "description": "Grafana's own vhost is excluded by default; its auto-refresh traffic would skew every panel."
      },
      {
        "type": "query",
        "name": "host",
        "label": "Host header",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "definition": "label_values({job=\"nginx\", logtype=\"access\"}, http_host)",
        "query": {
          "label": "http_host",
          "type": 1,
          "stream": "{job=\"nginx\", logtype=\"access\"}",
          "refId": "LokiVariableQueryEditor-VariableQuery"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ],
          "selected": true
        },
        "options": [],
        "hide": 0,
        "sort": 1,
        "description": "Host header the client sent. Unknown hosts collapse into \"other\"; the log line still shows the raw value."
      },
      {
        "type": "custom",
        "name": "nginxlevel",
        "label": "nginx level",
        "query": "notice,info,warn,error,crit,alert,emerg",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "current": {
          "text": [
            "warn",
            "error",
            "crit",
            "alert",
            "emerg"
          ],
          "value": [
            "warn",
            "error",
            "crit",
            "alert",
            "emerg"
          ],
          "selected": true
        },
        "options": [
          {
            "selected": false,
            "text": "All",
            "value": "$__all"
          },
          {
            "selected": false,
            "text": "notice",
            "value": "notice"
          },
          {
            "selected": false,
            "text": "info",
            "value": "info"
          },
          {
            "selected": true,
            "text": "warn",
            "value": "warn"
          },
          {
            "selected": true,
            "text": "error",
            "value": "error"
          },
          {
            "selected": true,
            "text": "crit",
            "value": "crit"
          },
          {
            "selected": true,
            "text": "alert",
            "value": "alert"
          },
          {
            "selected": true,
            "text": "emerg",
            "value": "emerg"
          }
        ],
        "description": "nginx severity. Defaults to warn and above: nginx writes worker start/reload notices into the error log, and Grafana renders 'notice' as INFO."
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "links": [
    {
      "type": "dashboards",
      "title": "ShareFrame dashboards",
      "tags": [
        "shareframe"
      ],
      "asDropdown": true,
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false,
      "url": ""
    }
  ],
  "panels": [
    {
      "type": "stat",
      "title": "Requests/s",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "wideLayout": true,
        "showPercentChange": false,
        "percentChangeColorMode": "standard"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(rate({job=\"nginx\", logtype=\"access\", server_name=~\"$vhost\", server_name!~\"$monvhost\", http_host=~\"$host\"} [$__auto]))"
        }
      ],
      "description": "Requests per second across the selected vhosts.",
      "id": 101
    },
    {
      "type": "stat",
